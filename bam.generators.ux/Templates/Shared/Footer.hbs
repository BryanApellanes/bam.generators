<footer class="footer">
    <div class="footer__container container">
        <div class="footer__grid">
            <div class="footer__about">
                <h3 class="footer__heading">{{Site.CompanyName}}</h3>
                {{#if Site.Description}}
                <p class="footer__description">{{Site.Description}}</p>
                {{/if}}
            </div>
            <div class="footer__contact">
                <h3 class="footer__heading">Contact</h3>
                <ul class="footer__contact-list">
                    {{#if Site.Phone}}
                    <li><a href="tel:{{Site.Phone}}">{{Site.Phone}}</a></li>
                    {{/if}}
                    {{#if Site.Email}}
                    <li><a href="mailto:{{Site.Email}}">{{Site.Email}}</a></li>
                    {{/if}}
                    {{#if Site.FullAddress}}
                    <li>{{Site.FullAddress}}</li>
                    {{/if}}
                </ul>
            </div>
            {{#if Site.HasSocialLinks}}
            <div class="footer__social">
                <h3 class="footer__heading">Follow Us</h3>
                <ul class="footer__social-list">
                    {{#if Site.FacebookUrl}}
                    <li><a href="{{Site.FacebookUrl}}" target="_blank" rel="noopener noreferrer" class="footer__social-link">Facebook</a></li>
                    {{/if}}
                    {{#if Site.LinkedInUrl}}
                    <li><a href="{{Site.LinkedInUrl}}" target="_blank" rel="noopener noreferrer" class="footer__social-link">LinkedIn</a></li>
                    {{/if}}
                    {{#if Site.TwitterUrl}}
                    <li><a href="{{Site.TwitterUrl}}" target="_blank" rel="noopener noreferrer" class="footer__social-link">Twitter</a></li>
                    {{/if}}
                    {{#if Site.GoogleBusinessUrl}}
                    <li><a href="{{Site.GoogleBusinessUrl}}" target="_blank" rel="noopener noreferrer" class="footer__social-link">Google Business</a></li>
                    {{/if}}
                </ul>
            </div>
            {{/if}}
            {{#if Site.EnabledIntegrations}}
            <div class="footer__integrations">
                <h3 class="footer__heading">Services</h3>
                <div class="footer__integrations-list">
                    {{#each Site.EnabledIntegrations}}
                    {{> IntegrationLink}}
                    {{/each}}
                </div>
            </div>
            {{/if}}
        </div>
        <div class="footer__bottom">
            <p class="footer__copyright">&copy; {{Site.CompanyName}}. All rights reserved.</p>
        </div>
    </div>
</footer>
