<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{Site.Description}}">
    <title>{{PageTitle}} | {{Site.CompanyName}}</title>
    {{#if Site.FaviconUrl}}
    <link rel="icon" href="{{Site.FaviconUrl}}" type="image/x-icon">
    {{/if}}
    <link rel="stylesheet" href="/css/{{Site.CompanySlug}}.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family={{Theme.FontFamily}}:wght@300;400;500;600;700&family={{Theme.HeadingFontFamily}}:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    {{> Header}}
    {{> Navigation}}
    <main class="layout__main">
        {{{Content}}}
    </main>
    {{> Footer}}
    {{#if Site.AuthEnabled}}
    <script src="{{Site.AuthApiUrl}}/auth.js" defer></script>
    {{/if}}
</body>
</html>
