<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generated fixtures are compiled into this assembly AND embedded, so a test can compare what is
         checked in against what the generator produces today. -->
    <EmbeddedResource Include="Fixtures\Generated\*.cs" LogicalName="Generated.%(Filename)%(Extension)" />
    <!-- The no-registry fixture declares the same types as its registry twin, so it is embedded but not compiled
         here; bam.generators.decorators.runtime.compat472 compiles it against the runtime alone. -->
    <Compile Remove="Fixtures\Generated\NoRegistry\*.cs" />
    <EmbeddedResource Include="Fixtures\Generated\NoRegistry\*.cs" LogicalName="Generated.NoRegistry.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\bam.base\bam.base\bam.base.csproj" />
    <ProjectReference Include="..\..\bam.console\bam.console\bam.console.csproj" />
    <ProjectReference Include="..\..\bam.test\bam.test\bam.test.csproj" />
    <ProjectReference Include="..\bam.generators\bam.generators.csproj" />
    <ProjectReference Include="..\bam.generators.decorators\bam.generators.decorators.csproj" />
  </ItemGroup>

</Project>
