<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Bam.Generators.Decorators</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <PackageId>bam.generators.decorators.runtime</PackageId>
    <Version>1.0.0</Version>
    <Authors>Bryan Apellanes</Authors>
    <Description>The runtime that decorators generated by bam.generators.decorators run on: Decorator&lt;I, T&gt;, invocation contexts and results, and the handler stores. Depends on nothing but the BCL and targets netstandard2.0, so a .NET Framework application can link a generated decorator without the Bam framework.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/BryanApellanes/bam.generators</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BryanApellanes/bam.generators</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>bam;decorator;interception;netstandard</PackageTags>
    <PackageOutputPath Condition=" '$(OS)' == 'Windows_NT' ">$(HOMEDRIVE)$(HOMEPATH)/.bam/build/pack/$(Configuration)/</PackageOutputPath>
    <PackageOutputPath Condition=" '$(OS)' != 'Windows_NT' ">$(HOME)/.bam/build/pack/$(Configuration)/</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The generator reads Awaitable to refuse task-returning handlers at generation time. -->
  <ItemGroup>
    <InternalsVisibleTo Include="bam.generators.decorators" />
  </ItemGroup>

  <!-- netstandard2.0 lacks the immutable collections and ValueTask; net10.0 has both inbox. -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.0" />
  </ItemGroup>

</Project>
